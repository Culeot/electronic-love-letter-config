{
  "styleId": "cyberpunk",
  "styleName": "赛博朋克/故障艺术",
  "description": "纯黑+霓虹粉+电光蓝+霓虹绿,霓虹灯,故障效果,电路板",
  "fonts": {
    "heading": {
      "family": "Orbitron, Rajdhani, Share Tech Mono, monospace",
      "recommended": "Orbitron",
      "usage": "大标题、章节标题"
    },
    "body": {
      "family": "Share Tech Mono, Exo 2, monospace",
      "recommended": "Share Tech Mono",
      "usage": "正文、段落文字"
    },
    "chinese": {
      "family": "站酷高端黑, 思源黑体, sans-serif",
      "recommended": "思源黑体",
      "usage": "中文标题和正文"
    },
    "decorative": {
      "family": "Audiowide, Orbitron, monospace",
      "recommended": "Audiowide",
      "usage": "装饰性文字、霓虹效果文字"
    }
  },
  "googleFonts": {
    "primary": {
      "name": "Orbitron",
      "url": "https://fonts.google.com/specimen/Orbitron",
      "weights": ["400", "700", "900"],
      "link": "<link href='https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&display=swap' rel='stylesheet'>"
    },
    "secondary": {
      "name": "Share Tech Mono",
      "url": "https://fonts.google.com/specimen/Share+Tech+Mono",
      "weights": ["400"],
      "link": "<link href='https://fonts.googleapis.com/css2?family=Share+Tech+Mono&display=swap' rel='stylesheet'>"
    },
    "tertiary": {
      "name": "Rajdhani",
      "url": "https://fonts.google.com/specimen/Rajdhani",
      "weights": ["400", "500", "700"],
      "link": "<link href='https://fonts.googleapis.com/css2?family=Rajdhani:wght@400;500;700&display=swap' rel='stylesheet'>"
    },
    "decorative": {
      "name": "Audiowide",
      "url": "https://fonts.google.com/specimen/Audiowide",
      "weights": ["400"],
      "link": "<link href='https://fonts.googleapis.com/css2?family=Audiowide&display=swap' rel='stylesheet'>"
    }
  },
  "importSnippet": "<link href='https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Share+Tech+Mono&family=Rajdhani:wght@400;500;700&family=Audiowide&display=swap' rel='stylesheet'>"
}
