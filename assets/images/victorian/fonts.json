{
  "styleId": "victorian",
  "styleName": "欧式复古/维多利亚",
  "description": "深红+金+旧米黄+深棕,繁复花边,罗马大写字母,羽毛笔",
  "fonts": {
    "heading": {
      "family": "Cinzel, Trajan Pro, serif",
      "recommended": "Cinzel",
      "usage": "大标题、章节标题"
    },
    "body": {
      "family": "Crimson Text, Garamond, serif",
      "recommended": "Crimson Text",
      "usage": "正文、段落文字"
    },
    "chinese": {
      "family": "方正清刻本悦宋, 思源宋体, serif",
      "recommended": "思源宋体",
      "usage": "中文标题和正文"
    },
    "decorative": {
      "family": "Great Vibes, Alex Brush, cursive",
      "recommended": "Great Vibes",
      "usage": "装饰性文字、签名"
    }
  },
  "googleFonts": {
    "primary": {
      "name": "Cinzel",
