    },
    "secondary": {
      "name": "Crimson Text",
      "url": "https://fonts.google.com/specimen/Crimson+Text",
      "weights": ["400", "600", "700"],
      "link": "<link href='https://fonts.googleapis.com/css2?family=Crimson+Text:wght@400;600;700&display=swap' rel='stylesheet'>"
    },
    "tertiary": {
      "name": "EB Garamond",
      "url": "https://fonts.google.com/specimen/EB+Garamond",
      "weights": ["400", "500", "700"],
      "link": "<link href='https://fonts.googleapis.com/css2?family=EB+Garamond:wght@400;500;700&display=swap' rel='stylesheet'>"
    },
    "decorative": {
      "name": "Great Vibes",
